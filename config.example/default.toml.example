# Default Configuration Profile
# Balanced configuration suitable for standard servers (4-8 cores, 8-16GB RAM)

[bitcoin]
# Path to Bitcoin blocks directory containing .blk files
# Update this to match your Bitcoin Core installation
blocks_dir = "/data/bitcoin/blocks"

# Starting block height for ingestion (0 = genesis block)
start_height = 0

# Ending block height for bounded ingestion (enables fast startup)
# For testing/development: 10000 (~10 seconds startup)
# For production: comment out or set to None to sync to chain tip (~2-5 min startup)
end_height = 10000

[neo4j]
# Neo4j connection settings
uri = "bolt://localhost:7687"
user = "neo4j"
password = "CHANGE_ME"
database = "neo4j"

# Balanced connection pool settings
max_connections = 10
min_connections = 2
connection_timeout_secs = 30
fetch_size = 500
max_retries = 3

[ingestion]
# Ingestion process settings
batch_size = 50
max_batch_memory_mb = 512

# Enable validation for data integrity
enable_validation = true
validate_every_n_blocks = 1000

# Checkpoint management
checkpoint_interval = 1
auto_resume = true
validate_on_resume = true

[performance]
# Performance tuning settings

# UTXO cache memory budget in megabytes
# Higher memory = better cache hit rate = fewer Neo4j queries = faster ingestion
# Default: 15 MB ≈ 108,000 entries (good for batch_size ≤ 200)
# Recommended for batch_size=500: 50 MB ≈ 362,000 entries
utxo_cache_memory_mb = 15

# Number of blocks to load backwards for cache pre-warming
# Loads recent outputs into cache before forward ingestion
utxo_prewarm_depth = 50

# Moderate parallelism for balanced throughput
parallel_batches = 4

# Progress reporting interval
progress_report_interval = 100
