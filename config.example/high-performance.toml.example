# High Performance Configuration Profile
# Optimized for powerful servers (16+ cores, 64GB+ RAM)
# Suitable for production ingestion workloads

[bitcoin]
# Path to Bitcoin blocks directory containing .blk files
blocks_dir = "/data/bitcoin/blocks"

# Starting block height for ingestion (0 = genesis block)
start_height = 0

# Optional ending block height (commented = sync to chain tip)
# end_height = 870000

[neo4j]
# Neo4j connection settings
uri = "bolt://localhost:7687"
user = "neo4j"
password = "CHANGE_ME"
database = "neo4j"

# Large connection pool for parallel processing
max_connections = 32
min_connections = 8
connection_timeout_secs = 30
fetch_size = 2000
max_retries = 3

[ingestion]
# Large batches for maximum throughput
batch_size = 200
max_batch_memory_mb = 2048

# Enable validation with less frequent checks
enable_validation = true
validate_every_n_blocks = 5000

[performance]
# Large cache and high parallelism
utxo_cache_size = 1000000

# High concurrency for maximum throughput
parallel_batches = 16

# Less frequent progress reports for high-speed ingestion
progress_report_interval = 500
